# OpenAI API key for image/video-frame analysis. Server only; never use NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# SaydiVoice text-to-speech preview. Server only.
SAYDI_API_BASE_URL=https://voice.saydi.ai/api
SAYDI_API_KEY=
SAYDI_MALE_VOICE_ID=
SAYDI_FEMALE_VOICE_ID=

# Private shared voice-library store (Vercel injects BLOB_STORE_ID when connected).
BLOB_STORE_ID=
# For local development outside Vercel only, instead of OIDC:
# BLOB_READ_WRITE_TOKEN=
# At least 12 characters. Server only, used for /admin/voices login.
VOICE_ADMIN_PASSWORD=
