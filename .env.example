# Vercel Blob (được cấp tự động khi kết nối Blob store)
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway dùng model OpenAI để phân tích khung hình và viết kịch bản.
# Trên Vercel ưu tiên OIDC tự động; local có thể dùng AI Gateway API key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# SaydiVoice tạo giọng đọc; mọi khoá chỉ được giữ ở server.
SAYDI_API_BASE_URL=https://voice.saydi.ai/api
SAYDI_API_KEY=
SAYDI_MALE_VOICE_ID=
SAYDI_FEMALE_VOICE_ID=
